<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".HomeFragment"
    android:background="@color/colorPrimary">
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inply_search"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:startIconTint="@color/colorText"
        app:cursorColor="@color/colorText"
        app:placeholderTextColor="@color/colorText"
        android:textColorHint="@color/colorText"
        app:boxStrokeColor="@color/colorText"
        app:layout_constraintStart_toStartOf="parent"
        app:startIconDrawable="@drawable/search"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="10dp"
        app:layout_constraintEnd_toStartOf="@id/txtvw_filter">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inpedt_search"
            android:layout_width="match_parent"
            android:paddingStart="48dp"
            android:hint="Search"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end"/>
    </com.google.android.material.textfield.TextInputLayout>
    <TextView
        android:id="@+id/txtvw_filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Filter"
        android:textSize="20dp"
        android:textColor="@color/colorText"
        android:textStyle="bold"
        android:padding="15dp"
        android:layout_marginHorizontal="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/inply_search"
        app:layout_constraintBottom_toBottomOf="@id/inply_search"/>

    <TextView
        android:id="@+id/txtvw_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Categoies"
        android:padding="10dp"
        android:textStyle="bold"
        android:textColor="@color/colorText"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/inply_search"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/txtvw_see_all"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="See All"
        android:padding="16dp"
        android:textSize="16dp"
        android:textColor="@color/colorText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBaseline_toBaselineOf="@id/txtvw_category"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:listitem="@layout/item_category"
        app:layout_constraintTop_toBottomOf="@id/txtvw_category"/>
    <TextView
        android:id="@+id/txtvw_products"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Products"
        android:padding="10dp"
        android:textColor="@color/colorText"
        android:textStyle="bold"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/rv_category"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_products"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/txtvw_products"/>

</androidx.constraintlayout.widget.ConstraintLayout>