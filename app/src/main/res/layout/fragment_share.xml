<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ShareFragment"
    android:background="@color/colorPrimary">

    <ImageView
        android:id="@+id/img_product_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/select_image"
        android:padding="20dp"
        android:background="@color/colorSecondary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        android:layout_margin="10dp"
        android:scaleType="fitCenter"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_add_image_from_gallery"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Open Gallery"
        android:textAllCaps="false"
        android:layout_margin="10dp"
        android:textColor="@color/colorPrimary"
        android:textSize="16sp"
        android:background="@drawable/inactive_navigate_button_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/img_product_image"
        app:layout_constraintEnd_toStartOf="@id/btn_take_a_photo"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_take_a_photo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Open Camera"
        android:textAllCaps="false"
        android:background="@drawable/inactive_navigate_button_background"
        android:textColor="@color/colorPrimary"
        android:textSize="16sp"
        android:layout_margin="10dp"
        app:layout_constraintStart_toEndOf="@id/btn_add_image_from_gallery"
        app:layout_constraintTop_toBottomOf="@id/img_product_image"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>