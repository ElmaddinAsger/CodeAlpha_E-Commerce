<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".SuccessSignUpFragment"
    android:background="@color/colorSecondary"
    android:gravity="center"
    android:padding="10dp">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="30dp"
            android:orientation="vertical"
            android:background="@color/colorPrimary">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/success_sign_up_message"
                android:textAlignment="center"
                android:padding="10dp"
                android:textColor="@color/colorText"
                android:textStyle="bold"
                android:textSize="20sp"/>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_continue_to_sign_in"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/continue_to_sign_in"
                android:textAllCaps="false"
                android:layout_marginTop="30dp"
                android:background="@drawable/inactive_navigate_button_background"
                android:textColor="@color/colorPrimary"
                android:textSize="20sp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>



</LinearLayout>