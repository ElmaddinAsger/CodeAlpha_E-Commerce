<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".SignUpFragment"
    android:padding="20dp"
    android:background="@color/colorPrimary">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inply_username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:startIconDrawable="@drawable/profile"
        app:startIconTint="@color/colorText"
        app:cursorColor="@color/colorText"
        app:placeholderTextColor="@color/colorText"
        android:textColorHint="@color/colorText"
        app:boxStrokeColor="@color/colorText"
        app:layout_constraintBottom_toTopOf="@id/inply_email"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.1">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inpedt_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/enter_username"
            android:paddingStart="48dp"
            android:inputType="text"
            android:textColor="@color/colorText"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end"/>
    </com.google.android.material.textfield.TextInputLayout>


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inply_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:startIconDrawable="@drawable/email"
        app:startIconTint="@color/colorText"
        app:cursorColor="@color/colorText"
        app:placeholderTextColor="@color/colorText"
        android:textColorHint="@color/colorText"
        app:boxStrokeColor="@color/colorText"
        app:layout_constraintTop_toBottomOf="@id/inply_username"
        app:layout_constraintBottom_toTopOf="@id/inply_password"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.3">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inpedt_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="48dp"
            android:hint="@string/enter_email"
            android:textColor="@color/colorText"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inply_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:passwordToggleEnabled="true"
        app:startIconDrawable="@drawable/lock"
        app:startIconTint="@color/colorText"
        app:passwordToggleTint="@color/colorText"
        app:cursorColor="@color/colorText"
        app:placeholderTextColor="@color/colorText"
        android:textColorHint="@color/colorText"
        app:boxStrokeColor="@color/colorText"
        android:layout_marginVertical="20dp"
        app:layout_constraintTop_toBottomOf="@id/inply_email"
        app:layout_constraintBottom_toTopOf="@id/inply_confirm_password">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inpedt_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/colorText"
            android:paddingStart="48dp"
            android:hint="@string/enter_password"
            android:inputType="textPassword"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inply_confirm_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="@color/colorText"
        app:startIconDrawable="@drawable/lock"
        app:startIconTint="@color/colorText"
        app:cursorColor="@color/colorText"
        app:placeholderTextColor="@color/colorText"
        android:textColorHint="@color/colorText"
        app:boxStrokeColor="@color/colorText"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/inply_password"
        app:layout_constraintBottom_toTopOf="@id/btn_sign_up">
         <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inpedt_confirm_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="48dp"
            android:hint="@string/confirm_password"
            android:textColor="@color/colorText"
            android:inputType="textPassword"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end"/>
    </com.google.android.material.textfield.TextInputLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_sign_up"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/colorAccent"
        android:text="@string/sign_up"
        android:textAllCaps="false"
        android:textColor="@color/colorPrimary"
        app:layout_constraintTop_toBottomOf="@id/inply_confirm_password"
        app:layout_constraintBottom_toTopOf="@id/txtvw_have_an_account"/>

    <TextView
        android:id="@+id/txtvw_have_an_account"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/have_an_account"
        android:paddingVertical="10dp"
        android:textAlignment="textEnd"
        android:layout_marginTop="20dp"
        app:layout_constraintWidth_percent="0.6"
        app:layout_constraintStart_toStartOf="parent"
        android:clickable="false"
        android:textColor="@color/colorText"
        app:layout_constraintTop_toBottomOf="@id/btn_sign_up"
        app:layout_constraintEnd_toStartOf="@id/txtvw_sign_in"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/txtvw_sign_in"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/sign_in"
        android:textStyle="bold"
        android:paddingStart="10dp"
        android:textColor="@color/colorText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/txtvw_have_an_account"
        app:layout_constraintTop_toTopOf="@id/txtvw_have_an_account"
        app:layout_constraintBottom_toBottomOf="@id/txtvw_have_an_account"
        app:layout_constraintBaseline_toBaselineOf="@id/txtvw_have_an_account"/>

    <TextView
        android:id="@+id/txtvw_error_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:padding="10dp"
        android:background="#8FFF7272"
        android:textStyle="bold|italic"
        tools:text="Error Message"
        android:textSize="18sp"
        android:visibility="invisible"
        android:textColor="@color/colorPrimary"
        android:textAlignment="center"
        app:layout_constraintVertical_bias="0.2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtvw_have_an_account"
        app:layout_constraintBottom_toBottomOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>