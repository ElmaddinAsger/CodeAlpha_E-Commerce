<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:paddingVertical="36dp"
    android:background="@color/colorPrimary"
    android:orientation="vertical">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainerView"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph"
        app:layout_constraintBottom_toTopOf="@id/cv_navigate_bar"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_navigate_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fragmentContainerView">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ly_navigate_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary">
        <ImageButton
            android:id="@+id/imgbtn_home"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:src="@drawable/home"
            android:layout_margin="10dp"
            android:contentDescription="Home"
            android:background="@drawable/active_navigate_button_background"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/imgbtn_search"/>

        <ImageButton
            android:id="@+id/imgbtn_search"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:src="@drawable/search"
            android:contentDescription="Search"
            android:layout_margin="10dp"
            android:background="@drawable/inactive_navigate_button_background"
            app:layout_constraintStart_toEndOf="@id/imgbtn_home"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/imgbtn_share"/>

        <ImageButton
            android:id="@+id/imgbtn_share"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:src="@drawable/share"
            android:contentDescription="Bookmark"
            android:layout_margin="10dp"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/inactive_navigate_button_background"
            app:layout_constraintStart_toEndOf="@id/imgbtn_search"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/imgbtn_download"/>

        <ImageButton
            android:id="@+id/imgbtn_download"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:src="@drawable/favorites"
            android:layout_margin="10dp"
            android:contentDescription="Download"
            android:background="@drawable/inactive_navigate_button_background"
            app:layout_constraintStart_toEndOf="@id/imgbtn_share"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/imgbtn_profile"/>

        <ImageButton
            android:id="@+id/imgbtn_profile"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:src="@drawable/profile"
            android:contentDescription="Profile"
            android:layout_margin="10dp"
            android:background="@drawable/inactive_navigate_button_background"
            app:layout_constraintStart_toEndOf="@id/imgbtn_download"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>